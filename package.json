{
  "name": "@arach/og",
  "version": "0.3.0",
  "packageManager": "bun@1.3.11",
  "description": "Declarative OG images via og-render (native WebKit) — real Google Fonts, no Chromium in npm",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./hudson": {
      "import": "./src/hudson/index.ts",
      "types": "./src/hudson/index.ts"
    },
    "./catalog": {
      "import": "./catalog/index.ts",
      "types": "./catalog/index.ts"
    }
  },
  "bin": {
    "og": "./dist/cli.js"
  },
  "files": [
    "dist",
    "native",
    "templates",
    "src/hudson",
    "catalog"
  ],
  "scripts": {
    "build": "tsc",
    "build:native": "cd native/og-render && swift build -c release && cd ../.. && bun scripts/stage-og-render.ts",
    "stage:native": "bun scripts/stage-og-render.ts",
    "release:native": "bash scripts/release-og-render.sh",
    "dev": "tsc --watch",
    "export-previews": "bun scripts/export-template-pages.ts",
    "review-pngs": "bun scripts/review-pngs.ts",
    "test": "node --test src/**/*.test.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "og",
    "opengraph",
    "social",
    "image",
    "webkit",
    "google-fonts",
    "no-puppeteer",
    "og-image",
    "generator"
  ],
  "author": "Arach",
  "license": "MIT",
  "dependencies": {
    "hudsonkit": "file:../hudson/packages/web/hudsonkit",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3"
  },
  "peerDependencies": {
    "esbuild": ">=0.17.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
